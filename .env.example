# ==============================================================================
# HydraForge Environment Configuration Template
# ==============================================================================

# Hugging Face Hub Credentials & Model Repository
HF_TOKEN=hf_your_token_here
HUGGINGFACE_TOKEN=hf_your_token_here
HF_HUB_TOKEN=hf_your_token_here

# Hugging Face Repositories for HydraForge / HydraVMS
HF_REPO=hydravision/yolo26m-person
HF_MODEL_URL=https://huggingface.co/hydravision/yolo26m-person
HF_OBJECT_REPO=hydravision/yolo26m-object
HF_FACE_REPO=hydravision/facial-recognition

# Local Storage Paths
MODELS_DIR=storage/models
ENGINES_DIR=storage/engines
DATASETS_DIR=datasets
RUNS_DIR=runs/train
